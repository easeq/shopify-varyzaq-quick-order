APP_ENV=development
APP_HANDLE=${{vault.dev-vault.APP_HANDLE}}

DATABASE_URL=${{vault.dev-vault.DATABASE_URL}}
REDIS_URL=${{vault.dev-vault.REDIS_URL}}
WORKER_ROLES=all
WORKER_READY_TIMEOUT_MS=30000
WEBHOOK_WORKER_CONCURRENCY=8
SUBSCRIPTION_WORKER_CONCURRENCY=4
SUBSCRIPTION_WORKER_RATE_LIMIT=4
SUBSCRIPTION_SYNC_MAX_AGE_HOURS=24
ADMIN_ENTITLEMENT_MAX_AGE_HOURS=24

SHOPIFY_API_VERSION=2026-10
SHOPIFY_PARTNER_API_VERSION=2026-10
SHOPIFY_API_KEY=${{vault.dev-vault.SHOPIFY_API_KEY}}
SHOPIFY_API_SECRET=${{vault.dev-vault.SHOPIFY_API_SECRET}}
SHOPIFY_APP_URL=${{vault.dev-vault.SHOPIFY_APP_URL}}
SCOPES=read_products,write_products,write_app_proxy

SHOPIFY_PARTNER_ORG_ID=${{vault.dev-vault.SHOPIFY_PARTNER_ORG_ID}}
SHOPIFY_PARTNER_ACCESS_TOKEN=${{vault.dev-vault.SHOPIFY_PARTNER_ACCESS_TOKEN}}
SHOPIFY_APP_GID=gid://shopify/App/${{vault.dev-vault.SHOPIFY_APP_ID}}
SHOPIFY_APP_ID=${{vault.dev-vault.SHOPIFY_APP_ID}}

SHOPIFY_THEME_BLOCK_HANDLE=variant-quick-order
LOG_LEVEL=info

# optional: only for custom shop domains
# SHOP_CUSTOM_DOMAIN=

# dev only
SHOPIFY_DEV_STORE=varyzaq-quick-order-dev
